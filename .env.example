# Ключ OpenRouter (homework_reviewer, провайдер openrouter)
OPENROUTER_API_KEY=

# Токен GitHub для приватных репозиториев (общий: ai_detector и homework_reviewer)
GITHUB_TOKEN=your_github_token_here

# Переопределение git-токена для ai_detector (приоритет над GITHUB_TOKEN)
AI_DETECTOR_GIT_TOKEN=

# Имя модели для ai_detector (локальный OpenAI-совместимый сервер, Structured Output)
AI_DETECTOR_LLM_MODEL=

# Провайдер детектора: local (OpenAI-совместимый сервер) | openrouter
AI_DETECTOR_LLM_PROVIDER=local

# Recommended OpenRouter configuration. This ordered free chain is defined in
# common/llm.py; set LLM_PROVIDER=ollama to use the existing local fallback.
# google/gemma-4-31b-it:free → nvidia/nemotron-3-super-120b-a12b:free →
# minimax/minimax-m3:free → poolside/laguna-s-2.1:free →
# z-ai/glm-5.2:free → openrouter/free.
# LLM_PROVIDER=openrouter
# MODEL_NAME=google/gemma-4-31b-it:free
# AI_DETECTOR_LLM_PROVIDER=openrouter
# AI_DETECTOR_LLM_MODEL=google/gemma-4-31b-it:free

# Local Ollama is used directly when LLM_PROVIDER=ollama and as the automatic
# fallback after an account-level OpenRouter free-tier daily-quota 429.
OLLAMA_FALLBACK_BASE_URL=http://localhost:11434/v1
OLLAMA_FALLBACK_MODEL=qwen2.5-coder
